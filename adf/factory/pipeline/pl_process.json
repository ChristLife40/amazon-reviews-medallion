{
	"name": "pl_process",
	"properties": {
		"activities": [
			{
				"name": "Copy_landing_csv",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.01:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"additionalColumns": [
							{
								"name": "source_file",
								"value": "$$FILEPATH"
							},
							{
								"name": "batch_id",
								"value": {
									"value": "@pipeline().parameters.batch_id",
									"type": "Expression"
								}
							},
							{
								"name": "ingest_ts",
								"value": {
									"value": "@utcNow()",
									"type": "Expression"
								}
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_landing_csv",
						"type": "DatasetReference",
						"parameters": {
							"file_name": {
								"value": "@pipeline().parameters.file_name",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_bronze_parquet",
						"type": "DatasetReference",
						"parameters": {
							"batch_id": {
								"value": "@pipeline().parameters.batch_id",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Scale_Vmss_up",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.0:15:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "PATCH",
					"headers": {
						"Content-Type": "application/json"
					},
					"httpRequestTimeout": "",
					"url": "https://management.azure.com/subscriptions/09c2707f-3793-42a1-b114-81e317caa781/resourceGroups/rg-revmed-dev/providers/Microsoft.Compute/virtualMachineScaleSets/vmss-revmed?api-version=2024-07-01",
					"connectVia": {
						"referenceName": "ir-shir",
						"type": "IntegrationRuntimeReference"
					},
					"body": {
						"value": "@json(concat('{\"sku\":{\"name\":\"Standard_D2pls_v6\",\"tier\":\"Standard\",\"capacity\":', string(pipeline().parameters.worker_count), '}}'))",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://management.azure.com/"
					}
				}
			},
			{
				"name": "wait_for_workers",
				"type": "Until",
				"dependsOn": [
					{
						"activity": "Scale_Vmss_up",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(variables('ready'), true)",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Probe_ilb_health",
							"type": "WebActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:10:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"url": "http://10.0.3.10:8080/health",
								"connectVia": {
									"referenceName": "ir-shir",
									"type": "IntegrationRuntimeReference"
								}
							}
						},
						{
							"name": "Set_ready",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Probe_ilb_health",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "pipelineReturnValue",
								"value": [
									{
										"key": "ready",
										"value": {
											"type": "Boolean",
											"content": true
										}
									}
								],
								"setSystemVariable": true
							}
						},
						{
							"name": "Wait_20s",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "Probe_ilb_health",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 20
							}
						}
					],
					"timeout": "0.00:20:00"
				}
			},
			{
				"name": "ForEach_shard",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "wait_for_workers",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Copy_landing_csv",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@range(0, pipeline().parameters.shard_count)",
						"type": "Expression"
					},
					"batchCount": 4,
					"activities": [
						{
							"name": "Process_shard",
							"type": "WebActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:10:00",
								"retry": 5,
								"retryIntervalInSeconds": 60,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "POST",
								"headers": {
									"Content-Type": "application/json"
								},
								"url": "http://10.0.3.10:8080/process",
								"connectVia": {
									"referenceName": "ir-shir",
									"type": "IntegrationRuntimeReference"
								},
								"body": {
									"value": "@json(concat('{\"batch_id\":\"', pipeline().parameters.batch_id, '\",\"shard\":', string(item()), ',\"shard_count\":', string(pipeline().parameters.shard_count), '}'))",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Reduce_gold",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "ForEach_shard",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 2,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "http://10.0.3.10.8080/reduce",
					"connectVia": {
						"referenceName": "ir-shir",
						"type": "IntegrationRuntimeReference"
					},
					"body": {
						"value": "@json(concat('{\"batch_id\":\"', pipeline().parameters.batch_id, '\"}'))",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"file_name": {
				"type": "string",
				"defaultValue": "Reviews.csv"
			},
			"shard_count": {
				"type": "int",
				"defaultValue": 4
			},
			"batch_id": {
				"type": "string"
			},
			"worker_count": {
				"type": "int",
				"defaultValue": 2
			}
		},
		"variables": {
			"ready": {
				"type": "Boolean"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-11-11T02:14:54Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}